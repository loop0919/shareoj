{
  "name": "judge-web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun --bun nuxt dev",
    "build": "bun --bun nuxt build",
    "preview": "bun --bun nuxt preview",
    "start": "bun .output/server/index.mjs",
    "postinstall": "bun --bun nuxt prepare",
    "typecheck": "bun --bun nuxt typecheck",
    "test": "bun --bun playwright test",
    "build:lambda": "OPENOJ_LAMBDA_BUILD=1 bun --bun nuxt build",
    "package:lambda": "bun run build:lambda && python3 scripts/package-lambda.py",
    "test:lambda": "python3 -m unittest discover -s scripts -p 'test_*.py' && bun scripts/test-lambda.mjs",
    "docs:screenshots": "bun --bun playwright test -c playwright.docs.config.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@mdit/plugin-katex": "^1.1.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "markdown-it": "^15.0.3",
    "markdown-it-container": "^4.0.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/markdown-it-container": "^4.0.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0"
  }
}
