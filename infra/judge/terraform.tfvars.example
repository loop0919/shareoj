# IPv6 connectivity from the operator machine is required.
ssh_public_key  = "ssh-ed25519 REPLACE"
admin_ipv6_cidr = "2001:db8::REPLACE/128"
# Empty for the initial installation. Copy install.sh's digest after smoke tests.
runtime_digest = ""
# terraform -chdir=infra/api output -json judge_bridge_database
database = {
  host              = "REPLACE"
  name              = "openoj"
  secret_arn        = "REPLACE"
  subnet_ids        = ["REPLACE", "REPLACE"]
  security_group_id = "REPLACE"
}
# terraform -chdir=infra/api output -json test_data_bucket
test_data_bucket = {
  id  = "REPLACE"
  arn = "REPLACE"
}
enabled = false
# Published runtime IDs; judge/rollout.py keeps this in zz-rollout.auto.tfvars.json afterwards.
enabled_runtimes = ["cpp17"]

# EC2 pool (ADR 0012). Lightsail hosts stay until worker_count = 0 after the cutover.
burst_worker_count        = 2
worker_availability_zones = ["ap-northeast-1a", "ap-northeast-1d"] # confirm t3.small offerings first
worker_volume_size        = 60
pool_alerts_enabled       = false # enable after the pool serves traffic
capacity_enabled          = false # enable after the pool serves traffic
burst_min_participants    = 10

# Optional Discord alerts: store the webhook outside Terraform.
discord_webhook_secret_arn = ""
discord_webhook_secret_key = "" # Set a JSON key if the existing secret is an object.
alerts_enabled = false # Enable after worker telemetry and notification tests pass.
# notify_package_path defaults to ../../api/.build/judge-notify.zip
# Build it together with the bridge: make -C api package-judge
